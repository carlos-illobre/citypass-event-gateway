KAFKA_BOOTSTRAP_SERVERS=kafka-authorizer:29092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
SECURITY_CONSUMER_GROUP=security-analysis-group
SECURITY_ALERT_FQN=com.citypass.security.AlertaDetectada
EVENT_GATEWAY_URL=http://event-gateway:8080
AUTH_SERVICE_URL=http://auth-simulator:8083
SECURITY_GATEWAY_CLIENT_ID=security
SECURITY_GATEWAY_CLIENT_SECRET=change-me-local
GATEWAY_TIMEOUT_SECONDS=5
ALERT_RETRY_INTERVAL_SECONDS=30
ALERT_MAX_PUBLICATION_ATTEMPTS=10
DATABASE_URL=postgresql+psycopg://citypass_security:change-me@security-db:5432/citypass_security
MIN_TRAINING_SAMPLES=50
RETRAIN_EVERY_N_EVENTS=100
MODEL_WINDOW_SIZE=2000
MIN_CLUSTERS=2
MAX_CLUSTERS=6
DISTANCE_PERCENTILE=95
TRAFFIC_SPIKE_ENABLED=true
TRAFFIC_SPIKE_MULTIPLIER=3.0
ALERT_COOLDOWN_SECONDS=300
