# Sólo para `npm run dev` y `npm run seed` — el build de producción no lee nada de acá,
# porque el bundle no tiene ninguna URL de ambiente adentro (ver README).

# A qué host reenvía el proxy de Vite. Los valores por defecto ya sirven si levantaste el
# stack con `docker compose up -d` desde la raíz del repositorio.
GATEWAY_ORIGIN=http://localhost:8080
AUTH_ORIGIN=http://localhost:8083
ANOMALY_ORIGIN=http://localhost:8084

# Credenciales que usa `npm run seed` para registrar tipos de demostración y publicar
# eventos. `grupo1` es el cliente de este equipo en el simulador de identidad.
SEED_GATEWAY_URL=http://localhost:8080
SEED_AUTH_URL=http://localhost:8083
SEED_CLIENT_ID=grupo1
SEED_CLIENT_SECRET=grupo1
