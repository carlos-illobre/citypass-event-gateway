# ===== CityPass+ EDA — valores para DESARROLLO LOCAL =====
#
#   cp .env.dev .env && docker compose up -d
#
# Hay un solo docker-compose.yml. Todo lo que cambia entre ambientes está acá y en su
# gemelo .env.prod.
#
# Los defaults del compose son los valores de PRODUCCIÓN, no los de este archivo: si
# una variable falta, la configuración queda cerrada, no abierta. Por eso este archivo
# define todas — en desarrollo casi todas hay que aflojarlas a propósito.


# ── Exposición de puertos ─────────────────────────────────────────────────────

# Interfaz del host donde se publican los puertos de los contenedores.
# En 0.0.0.0 los servicios son alcanzables desde otras máquinas de tu red, que es lo
# que se quiere en desarrollo para probar desde el celular o desde otra compu.
PUBLISH_ADDR=0.0.0.0

# Puerto del host para el listener externo de Kafka. En desarrollo el 9092 está libre
# porque no hay reverse-proxy, así que el broker lo usa directamente y los clientes se
# conectan a localhost:9092.
KAFKA_HOST_PORT=9092

# Perfiles de Compose activos. Vacío: reverse-proxy y certbot no se levantan. En
# desarrollo cada servicio se habla directo por su puerto, sin TLS.
COMPOSE_PROFILES=


# ── Identidad de red ──────────────────────────────────────────────────────────

# Hostname del broker que se anuncia a los clientes. Un cliente Kafka primero pide
# metadata y después se reconecta a la dirección que el broker le devuelve, así que
# este valor tiene que ser alcanzable DESDE EL CLIENTE, no desde el contenedor.
KAFKA_ADVERTISED_HOST=localhost

# Sólo se usan en producción, para emitir el certificado. Vacías en desarrollo.
PUBLIC_DOMAIN=
CERTBOT_EMAIL=


# ── Comportamiento del event-gateway ──────────────────────────────────────────

# Único interruptor de ambiente del gateway. Activa application-development.yml, que
# afloja tres cosas a la vez: acepta webhooks hacia IPs privadas (los consumidores de
# este compose las tienen), publica Swagger UI, y sube el log a DEBUG para ver el
# payload de cada evento.
#
# Van juntas a propósito. Antes eran tres variables sueltas y se podían poner dos y
# olvidar la tercera; así no hay estado parcial posible.
SPRING_PROFILES_ACTIVE=development


# ── kafka-ui ──────────────────────────────────────────────────────────────────

# Login propio de kafka-ui. Es la única credencial del sistema que no sale del
# servicio de identidad, porque kafka-ui es una herramienta de administración y el
# auth-simulator sólo hace client_credentials: un navegador no puede autenticarse
# contra él.
#
# En local da igual el valor; la autenticación está activa igual para que lo que
# corrés sea lo mismo que corre en producción.
# Interfaz donde se publica kafka-ui, independiente de PUBLISH_ADDR.
#   0.0.0.0   → accesible desde la red (desarrollo)
#   127.0.0.1 → sólo por túnel SSH (producción)
KAFKA_UI_PUBLISH_ADDR=0.0.0.0

KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=admin


# ── Grafana ───────────────────────────────────────────────────────────────────

# Credenciales del administrador de Grafana. Como las de kafka-ui, no salen del servicio
# de identidad: Grafana es una herramienta de operación y el emisor sólo hace
# client_credentials, así que un navegador no puede autenticarse contra él.
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin


# ── CORS y URLs del frontend ──────────────────────────────────────────────────

# Orígenes que pueden llamar a cada servicio desde el navegador. Sin el puerto exacto
# el navegador bloquea la llamada.
#   5173 → la UI que sirve el contenedor event-gateway-ui
#   5174 → `vite dev` corriendo fuera de Docker, con recarga en caliente
# Están los dos para poder trabajar con ambos a la vez. En producción va sólo el dominio.
AUTH_CORS_ORIGIN=http://localhost:5173,http://localhost:5174
GATEWAY_CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# URLs que Vite embebe en el build de la UI. Se resuelven en el navegador del usuario,
# no dentro de Docker, así que van a localhost y no a los nombres de los contenedores.
# Cambiarlas exige reconstruir la imagen: son argumentos de build, no de runtime.
LOGIN_API_URL=http://localhost:8083
GATEWAY_API_URL=http://localhost:8080/api/v1

# ─────────────────────────────────────────────────────────────────────────────
# Imágenes
# ─────────────────────────────────────────────────────────────────────────────

# Prefijo de las imágenes que construye este repositorio.
#
# En desarrollo se construyen y se usan localmente, así que alcanza un nombre corto. En
# producción apunta al registro desde donde la instancia las descarga, y ahí nunca se
# construye nada: se traen ya compiladas.
IMAGE_PREFIX=citypass-eda

# Versión de las imágenes a usar.
#
# En desarrollo siempre es la última que construiste. En producción la escribe el
# despliegue con el SHA del commit, para que sea evidente qué está corriendo y para poder
# volver atrás apuntando al SHA anterior.
TAG=latest

# ─────────────────────────────────────────────────────────────────────────────
# Techos de recursos
# ─────────────────────────────────────────────────────────────────────────────
#
# Dependen del ambiente: la memoria de la máquina y el tamaño del disco no son los
# mismos en una laptop que en la VM que la hospede. Por eso viven acá y no en el
# compose — que no sabe dónde va a correr.
#
# Los tres bloques responden a tres formas de tumbar el servicio:
# el disco lleno, la memoria agotada y la CPU saturada.

# ── Memoria máxima por contenedor ────────────────────────────────────────────
#
# Sin techo, cualquiera de los nueve puede consumir toda la RAM y disparar al OOM
# killer del kernel, que elige al proceso más grande —normalmente el broker— y se lleva
# puesto todo, no sólo al que se desbocó.
#
# Los JVM leen el límite del contenedor y ajustan su heap solo (por defecto al 25 %),
# así que no hace falta configurarles -Xmx aparte.

# Los mismos valores que producción: si algo no entra acá,
MEM_LIMIT_KAFKA=2g
# conviene descubrirlo en la laptop y no en el servidor.
MEM_LIMIT_SCHEMA_REGISTRY=1g
MEM_LIMIT_EVENT_GATEWAY=1g
MEM_LIMIT_KAFKA_UI=768m
MEM_LIMIT_PROMETHEUS=512m
MEM_LIMIT_GRAFANA=384m
MEM_LIMIT_ANOMALY_DETECTOR=512m
MEM_LIMIT_AUTH_SIMULATOR=256m
MEM_LIMIT_EVENT_GATEWAY_UI=128m

# ── Disco ────────────────────────────────────────────────────────────────────

# Igual que en producción: un disco lleno en desarrollo también arruina el día.
# 512 KB por archivo y dos archivos: un megabyte por contenedor, que es lo que se lee
# antes de aburrirse. Se parte en dos en vez de usar uno solo de 1 MB porque con un solo
# archivo, al rotar se pierde el log entero justo cuando algo estaba pasando.
LOG_MAX_SIZE=512k
LOG_MAX_FILES=2

# Retención de Kafka por tamaño, en bytes POR PARTICIÓN — hay una por event type, así
# que el total es este número × la cantidad de event types.
KAFKA_RETENTION_BYTES=5242880

# Tamaño de segmento. Kafka borra segmentos enteros, así que si el segmento fuera más
# grande que la retención nunca se borraría nada. Ver la nota en .env.prod.
KAFKA_SEGMENT_BYTES=1048576


# ── Límites de la API ────────────────────────────────────────────────────────

# Holgados: en desarrollo lo que molesta es que un script de prueba choque contra el
# límite, no que llene el disco.
RATE_LIMIT_PER_MINUTE=600
MAX_PAYLOAD_BYTES=262144

# Máximo de event types por namespace.
#
# Es el único techo posible a la cantidad de tópicos: el gateway es el único que puede
# crearlos, porque el authorizer se lo niega a todo cliente externo y la autocreación del
# broker está apagada. Y la cantidad de tópicos es lo que multiplica a KAFKA_RETENTION_BYTES.
#
# Con 25 y ocho namespaces son 200 event types como mucho: unos 200 x 5 MB = 1 GB de
# disco, y 250 particiones contando las internas de Kafka. El disco aguanta de sobra; el
# que se degrada antes es el broker, que en esta VM tiene dos núcleos.
MAX_EVENT_TYPES_PER_NAMESPACE=25

# Máximo de event types en todo el bus, sumando los de todos los equipos.
#
# El límite por namespace impide que un equipo solo acapare; éste acota el total, que es
# lo que multiplica a KAFKA_RETENTION_BYTES y por lo tanto lo que ocupa el disco.
#
# Si se agota, NADIE puede crear un event type nuevo —tenga o no lugar en su propio
# cupo— hasta que se borre alguno de los existentes. Es a propósito: el disco es un
# recurso compartido y no hay forma de que un equipo se lleve la parte de otro.
#
# 200 x 5 MB de retención = 1 GB de datos en Kafka. Coincide con lo que darían ocho
# equipos usando sus 25 completos, así que los dos techos son coherentes entre sí.
MAX_EVENT_TYPES_TOTAL=200




# ── Límites del reverse-proxy ────────────────────────────────────────────────
#
# Sólo se aplican con el perfil prod, que en desarrollo no se levanta. Se declaran igual
# para que los dos archivos tengan el mismo conjunto de variables: el que falte en uno
# de los dos cae en su default sin que nada avise.
NGINX_RATE_LIMIT=50r/s
NGINX_RATE_BURST=100
NGINX_CONN_LIMIT=100
NGINX_MAX_BODY=1m
