# ===== CityPass+ EDA — configuración =====
#
#   cp .env.example .env
#
# Tal como está, este archivo **funciona en una máquina de desarrollo sin tocar nada**:
# `docker compose up -d --build` levanta el sistema completo y la UI queda en
# http://localhost:5173.
#
# Hay un solo docker-compose.yml para todos los ambientes (ver ADR-014). Todo lo que
# cambia entre uno y otro está acá, y cada variable explica al lado qué pasa si se toca.
#
# El `.env` real está en .gitignore y nunca se sube: este archivo es la plantilla.
#
# Para desplegar en un servidor hay que cambiar un puñado de valores —los que están
# marcados con «EN UN SERVIDOR»—. Si el servidor es Oracle Cloud, la carpeta `oracle/`
# tiene una versión de este archivo ya ajustada y la guía paso a paso.
#
#
# ─────────────────────────────────────────────────────────────────────────────
#  QUÉ FALTA ANTES DE EXPONER ESTO A INTERNET
# ─────────────────────────────────────────────────────────────────────────────
#
#  1. UN DOMINIO. Let's Encrypt no emite certificados para una IP pelada, y sin
#     certificado de una CA pública cada grupo tendría que instalar un truststore propio
#     en su cliente de Kafka; el que no lo logre va a terminar desactivando la
#     verificación, que es peor que no tener TLS porque parece seguro.
#
#  2. EL CERTIFICADO, ANTES DEL PRIMER ARRANQUE. nginx no levanta sin certificado y
#     certbot necesita el puerto 80: hay un orden obligatorio (docs/DEPLOYMENT.md).
#
#  3. REEMPLAZAR EL SERVICIO DE IDENTIDAD. auth-simulator es un mock: credenciales fijas
#     en el código y clave de firma que se regenera en cada arranque, o sea que cada
#     reinicio invalida todos los tokens emitidos.
#
#  4. UNA SOLA INSTANCIA DE CADA COSA. Las suscripciones y los schemas viven en archivos
#     dentro de un volumen local; perder el volumen las borra.
#
#  5. EL DISCO ES UN TECHO DURO, NO UN AVISO. Lo acotan tres cosas, todas más abajo: la
#     rotación de los logs, la retención de Kafka por tamaño, y el rate limit por
#     namespace multiplicado por el tamaño máximo del evento.
#
# ─────────────────────────────────────────────────────────────────────────────


# ── Exposición de puertos ─────────────────────────────────────────────────────

# Interfaz del host donde se publican los puertos de los contenedores.
#
# En 0.0.0.0 se llega desde otras máquinas de la red, que es lo cómodo mientras se
# desarrolla.
#
# EN UN SERVIDOR: `127.0.0.1`. Ahí Docker no programa la regla de entrada, así que desde
# internet esos puertos NO EXISTEN, y el único servicio que escucha hacia afuera es el
# reverse-proxy. Dejarlo en 0.0.0.0 en una máquina con IP pública expone Kafka sin TLS, el
# Schema Registry, Prometheus y Grafana, todos sin pasar por el proxy.
PUBLISH_ADDR=0.0.0.0

# Puerto del host para el listener externo de Kafka.
#
# EN UN SERVIDOR: cualquiera menos 9092. Ese puerto lo ocupa el reverse-proxy, que termina
# TLS y reenvía al broker; con los dos en 9092 el proxy no puede reservarlo, Docker deja el
# contenedor sin red, y nginx entra en un bucle de reinicios quejándose de que no resuelve
# los upstreams — un síntoma que no se parece en nada a la causa.
KAFKA_HOST_PORT=9092

# Perfiles de Compose activos. Vacío = sin reverse-proxy ni certbot, que es lo que hace
# falta en local: cada servicio se habla directo por su puerto.
#
# EN UN SERVIDOR: `prod`. El valor tiene que ser exactamente ese — Compose ignora en
# silencio un perfil que no existe, así que si el proxy no aparece, esto es lo primero que
# hay que mirar.
COMPOSE_PROFILES=


# ── Identidad de red ──────────────────────────────────────────────────────────

# Hostname del broker que se anuncia a los clientes. Un cliente Kafka pide metadata y
# después se reconecta a la dirección que el broker le devuelve.
#
# EN UN SERVIDOR: el dominio público, y el MISMO del certificado o la verificación TLS
# falla.
KAFKA_ADVERTISED_HOST=localhost

# Dominio del certificado y mail de aviso de Let's Encrypt. No los lee el compose: los usa
# el comando de emisión inicial de certbot (docs/DEPLOYMENT.md). En local van vacíos.
PUBLIC_DOMAIN=
CERTBOT_EMAIL=


# ── Comportamiento del event-gateway ──────────────────────────────────────────

# Único interruptor de ambiente del gateway.
#
# `development` afloja tres cosas a la vez, todas necesarias para trabajar en local:
#   - acepta webhooks hacia la red interna, sin lo cual no se puede probar una entrega
#     entre contenedores del propio compose
#   - publica Swagger en /swagger-ui/index.html
#   - loguea en DEBUG, o sea el payload de cada evento
#
# EN UN SERVIDOR: **vacío**. Los valores de producción están escritos literales en
# application.yml y rigen mientras no se active ningún perfil. El de los webhooks es el que
# más importa: con `development`, el gateway acepta un callback hacia la red interna, y en
# un servidor de cloud eso incluye el endpoint de metadata de la instancia
# (169.254.169.254) — un SSRF directo contra sus credenciales.
#
# Sólo el valor exacto `development` los afloja. Vacío, mal escrito o cualquier otro nombre
# deja producción, que es la dirección segura para equivocarse.
SPRING_PROFILES_ACTIVE=development


# ── kafka-ui ──────────────────────────────────────────────────────────────────

# Interfaz donde se publica kafka-ui, independiente de PUBLISH_ADDR.
#
# EN UN SERVIDOR: `127.0.0.1`, y se llega por túnel SSH. En 0.0.0.0 expondría a la red una
# consola con permisos de administración total del cluster, y encima sin pasar por el
# reverse-proxy.
KAFKA_UI_PUBLISH_ADDR=0.0.0.0

# Login propio de kafka-ui, una de las dos credenciales del sistema fuera del servicio de
# identidad: kafka-ui administra el cluster entero, y el auth-simulator sólo hace
# client_credentials, así que un navegador no tiene cómo autenticarse contra él.
#
# EN UN SERVIDOR: una contraseña de verdad, escrita SÓLO en el `.env` de esa máquina.
# Este archivo se versiona.
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=admin


# ── Grafana ───────────────────────────────────────────────────────────────────

# Credenciales del administrador de Grafana, con la misma advertencia que kafka-ui.
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin


# ── CORS y URLs del frontend ──────────────────────────────────────────────────

# Orígenes que pueden llamar a cada servicio desde el navegador. **Nunca un asterisco**:
# con CORS abierto, cualquier página que visite un usuario logueado puede hacer llamadas al
# gateway con su sesión.
#
# EN UN SERVIDOR: un solo origen, el dominio real con https.
AUTH_CORS_ORIGIN=http://localhost:5173,http://localhost:5174
GATEWAY_CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# URLs que Vite embebe en el build de la UI. Se resuelven en el navegador del usuario, así
# que van a donde el navegador pueda llegar, no a los nombres de los contenedores.
#
# Se leen en TIEMPO DE EJECUCIÓN, no en el build: el entrypoint del contenedor genera
# `config.js` con envsubst a partir de estas variables. Cambiarlas exige recrear el
# contenedor —`docker compose up -d event-gateway-ui`— pero **no** reconstruir la imagen.
#
# Es lo que permite que la misma imagen del registro sirva en cualquier ambiente.
LOGIN_API_URL=http://localhost:8083
GATEWAY_API_URL=http://localhost:8080/api/v1


# ─────────────────────────────────────────────────────────────────────────────
# Imágenes
# ─────────────────────────────────────────────────────────────────────────────

# Prefijo de las imágenes. Sin registro, `docker compose build` las construye y las etiqueta
# localmente, que es lo que se quiere mientras se desarrolla.
#
# EN UN SERVIDOR: el registro desde donde bajarlas ya compiladas. Compilar en la instancia
# deja la aplicación degradada durante el build, llena el disco de caché, y si el build
# falla te quedaste sin ambiente.
IMAGE_PREFIX=citypass-eda

# Versión desplegada. En local, `latest`.
TAG=latest


# ─────────────────────────────────────────────────────────────────────────────
# Techos de recursos
# ─────────────────────────────────────────────────────────────────────────────
#
# Dependen de la máquina: la memoria y el disco no son los mismos en una laptop que en un
# servidor. Por eso viven acá y no en el compose, que no sabe dónde va a correr.
#
# Los tres bloques responden a tres formas de tumbar el servicio: la memoria agotada, el
# disco lleno y la CPU saturada.

# ── Memoria máxima por contenedor ────────────────────────────────────────────
#
# Suman 6,5 GiB. Sin techo, cualquiera de los nueve contenedores puede consumir toda la RAM
# y disparar al OOM killer del kernel, que elige al proceso más grande —normalmente el
# broker— y se lleva puesto todo, no sólo al que se desbocó.
#
# Los JVM leen el límite del contenedor y ajustan su heap solos (por defecto al 25 %), así
# que no hace falta configurarles -Xmx aparte.

# El broker: el que más pesa y el que más duele perder.
MEM_LIMIT_KAFKA=2g
MEM_LIMIT_SCHEMA_REGISTRY=1g
# Medido en reposo: ~360 MB.
MEM_LIMIT_EVENT_GATEWAY=1g
MEM_LIMIT_KAFKA_UI=768m
MEM_LIMIT_PROMETHEUS=512m
MEM_LIMIT_GRAFANA=384m
# Carga scikit-learn.
MEM_LIMIT_ANOMALY_DETECTOR=512m
MEM_LIMIT_AUTH_SIMULATOR=256m
# Sólo sirve estáticos.
MEM_LIMIT_EVENT_GATEWAY_UI=128m

# ── Disco ────────────────────────────────────────────────────────────────────

# Tamaño máximo del log de cada contenedor, y cuántos archivos rotados se guardan.
#
# El driver json-file de Docker NO tiene límite por defecto: cada línea que escribe un
# servicio se guarda para siempre. Es la forma más silenciosa de llenar un disco, porque no
# pasa por ningún rate limit ni deja rastro en la aplicación.
#
# 512 KB por archivo y dos archivos: 1 MB por contenedor. Se parte en dos en vez de usar uno
# solo de 1 MB porque con un solo archivo, al rotar se pierde el log entero justo cuando
# algo estaba pasando.
LOG_MAX_SIZE=512k
LOG_MAX_FILES=2

# Retención de Kafka por TAMAÑO, en bytes POR PARTICIÓN.
#
# La retención por tiempo que trae el broker por defecto (7 días) no acota el disco: si
# entran más datos de los que caben, se llena igual. Ésta sí es un techo.
#
# OJO CON LA UNIDAD: Kafka no tiene un límite global por broker. Esto es por partición, y
# hay una por event type, así que el total es este número × la cantidad de event types. Con
# 5 MB y el techo de 200 tópicos de más abajo, el máximo es ~1 GB.
KAFKA_RETENTION_BYTES=5242880

# Tamaño de cada segmento del log, en bytes.
#
# No es un detalle: Kafka borra SEGMENTOS enteros, nunca eventos sueltos. Con el default de
# 1 GB el segmento activo crecería hasta 1 GB antes de rotar, así que una retención de 5 MB
# no podría borrar nada y el techo de arriba sería decorativo.
KAFKA_SEGMENT_BYTES=1048576

# Cuánto sobrevive el offset de un consumer group inactivo, en minutos.
#
# `__consumer_offsets` es compactado y por lo tanto NO lo acota KAFKA_RETENTION_BYTES: la
# compactación conserva el último registro por clave, y la clave incluye el `group.id`. Un
# cliente autenticado puede unirse a grupos con nombres distintos indefinidamente y cada
# nombre es una clave nueva; Kafka no tiene techo de cantidad de grupos, así que esta
# ventana es lo único que acota el total.
#
# En local se deja el default de Kafka (7 días): acá el disco no es el problema, y un offset
# que se vence solo mientras depurás es una fuente de confusión gratuita.
#
# EN UN SERVIDOR: bajarlo. El precio es que un consumidor apagado más que la ventana pierde
# su offset y vuelve a leer según su `auto.offset.reset`.
KAFKA_OFFSETS_RETENTION_MINUTES=10080

# Segmento de `__consumer_offsets`. El segmento activo no se compacta nunca, así que con el
# default de 100 MB el tópico crece hasta ahí antes de limpiarse por primera vez.
KAFKA_OFFSETS_SEGMENT_BYTES=10485760


# ── Límites de la API ────────────────────────────────────────────────────────

# Peticiones por minuto y por namespace, y tamaño máximo del cuerpo de un evento.
#
# Estos dos números multiplicados son la velocidad a la que un equipo puede llenar el disco.
# Holgados en local: acá lo que molesta es que un script de prueba choque contra el límite,
# no que llene el disco.
#
# EN UN SERVIDOR: bajar RATE_LIMIT_PER_MINUTE a un orden de 60.
RATE_LIMIT_PER_MINUTE=600
MAX_PAYLOAD_BYTES=262144

# Máximo de TÓPICOS por namespace.
#
# Se cuentan tópicos y no event types: cada versión mayor de un event type es un tópico con
# su propia retención, y el cupo existe para acotar el disco.
#
# Es el único techo posible a la cantidad de tópicos: el gateway es el único que puede
# crearlos, porque el authorizer se lo niega a todo cliente externo y la autocreación del
# broker está apagada.
MAX_EVENT_TYPES_PER_NAMESPACE=25

# Máximo de TÓPICOS en todo el bus, sumando los de todos los equipos.
#
# Si se agota, NADIE puede crear un event type nuevo —tenga o no lugar en su propio cupo—
# hasta que se borre alguno. Es a propósito: el disco es un recurso compartido y no hay
# forma de que un equipo se lleve la parte de otro.
MAX_EVENT_TYPES_TOTAL=200

# Máximo de versiones mayores de un mismo event type.
#
# Cada versión es un tópico aparte, con su propia retención. Sin este techo, repetir un PUT
# con schemas incompatibles crea un tópico por llamada: con las credenciales de ocho equipos
# son 480 tópicos por minuto, y ni el cupo por namespace ni el total lo veían porque
# contaban nombres lógicos en lugar de tópicos.
MAX_VERSIONS_PER_EVENT_TYPE=5


# ── Webhooks ─────────────────────────────────────────────────────────────────

# Webhooks que un mismo equipo puede tener sobre un mismo event type.
#
# La entrega bloquea al consumer hasta atender a TODOS los suscriptores, así que la cantidad
# de webhooks por tópico es el factor de amplificación de cada evento: sin techo, un equipo
# puede hacer que un solo evento dispare miles de peticiones salientes antes de que el
# tópico avance.
MAX_WEBHOOKS_PER_EVENT_TYPE=3

# Eventos seguidos sin poder entregar tras los cuales se deja de intentar.
#
# Los reintentos cubren un fallo pasajero; esto cubre un destino que ya no existe. Con los
# timeouts actuales, un webhook muerto bloquea su tópico hasta 19 segundos por mensaje, y
# alcanza uno solo para frenarlo indefinidamente.
WEBHOOK_FAILURES_BEFORE_DISABLE=5

# Cuánto se espera antes de volver a probar una suscripción silenciada. Al vencer entra de
# nuevo en el reparto y, si el destino se recuperó, se rehabilita sola.
WEBHOOK_DISABLE_MINUTES=10


# ── Límites del reverse-proxy ────────────────────────────────────────────────
#
# Sólo se aplican con COMPOSE_PROFILES=prod, o sea que en local no hacen nada. Se declaran
# igual para que todos los archivos de configuración tengan el mismo conjunto de variables:
# la que falte en uno cae en su default sin que nada avise.
#
# El rate limit del gateway es POR NAMESPACE, sacado del JWT, así que sólo alcanza a las
# peticiones autenticadas que llegan hasta él. Las que van a /auth/ no lo tocan — y emitir
# un token es una firma RSA, cara en CPU. Sin un límite acá, martillar ese endpoint es la
# forma más barata de saturar la máquina.

# Peticiones por segundo y por IP, y cuántas se aceptan de más en una ráfaga.
NGINX_RATE_LIMIT=50r/s
NGINX_RATE_BURST=100

# Conexiones simultáneas por IP.
NGINX_CONN_LIMIT=100

# Tamaño máximo del cuerpo. Corta antes de que el cuerpo llegue a la aplicación.
NGINX_MAX_BODY=1m

# Conexiones simultáneas por IP al puerto de Kafka (9092).
#
# Vive aparte de NGINX_CONN_LIMIT porque son dos bloques distintos de nginx —`stream` y
# `http`— y el límite de uno no alcanza al otro. Es el único techo que actúa contra alguien
# SIN credenciales: la conexión TLS se acepta antes de negociar SASL. Y como
# `worker_connections` se comparte entre los dos bloques, sin esto agotar el 9092 tumbaría
# también la API y la UI.
NGINX_KAFKA_CONN_LIMIT=50
