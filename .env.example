# ===== CityPass+ EDA - Environment Configuration =====
# Modify these values for cloud deployment (e.g., Oracle Cloud VPS)

# --- External Ports (mapped to host) ---
KAFKA_EXTERNAL_PORT=9092
SCHEMA_REGISTRY_PORT=8081
KAFKA_UI_PORT=8090
EVENT_GATEWAY_PORT=8080
GROUP3_SIMULATOR_PORT=3000
AUTH_SIMULATOR_PORT=8083
ANOMALY_DETECTOR_PORT=8084

# --- Anomaly Detector (Isolation Forest) ---
# Eventos mínimos antes del primer entrenamiento
ANOMALY_MIN_SAMPLES=50
# Re-entrenar cada N eventos nuevos
ANOMALY_RETRAIN_EVERY_N=100
# Fracción de eventos considerados anómalos (0.05 = 5%)
ANOMALY_CONTAMINATION=0.05

# --- Seguridad JWT ---
# false = sin autenticación (desarrollo local)
# true  = requiere Bearer token JWT en cada request de escritura
SECURITY_ENABLED=false

# --- Kafka Broker ---
KAFKA_ADVERTISED_HOST=localhost
KAFKA_BROKER_ID=1
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_AUTO_CREATE_TOPICS=true

# --- Internal (normally don't change) ---
KAFKA_INTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=9093
KAFKA_JMX_PORT=9101
