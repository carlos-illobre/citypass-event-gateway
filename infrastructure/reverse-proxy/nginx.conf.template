# Reverse proxy de CityPass+ — sólo se usa en producción.
#
# Existe por dos motivos, y el segundo importa tanto como el primero:
#
#  1. Termina TLS. Sin esto el JWT viaja en claro, y todo el modelo de seguridad
#     —namespaces, ownership de suscripciones, el authorizer del broker— cuelga de
#     ese token: quien lo capture publica y consume como ese grupo.
#
#  2. Es el único servicio que escucha hacia afuera. El resto publica sus puertos
#     sobre 127.0.0.1 (PUBLISH_ADDR), así que desde internet no existen. Antes de
#     esto, el Schema Registry (8081) y kafka-ui (8090) quedaban expuestos sin
#     ninguna autenticación: cualquiera podía borrar subjects o administrar el
#     cluster.
#
# No tiene ninguna variable a propósito. La alternativa era expandirlo con envsubst
# al arrancar, pero envsubst también reemplazaría las variables propias de nginx
# ($host, $scheme, $proxy_add_x_forwarded_for) por cadenas vacías. En vez de eso el
# certificado se emite con un nombre fijo (certbot --cert-name citypass), así que la
# ruta no depende del dominio y el archivo se monta tal cual.

# ── Capacidad ────────────────────────────────────────────────────────────────
#
# Un worker por núcleo y 4096 conexiones cada uno. Antes era un solo worker con 1024, y
# como ese techo lo comparten el 443 y el 9092 —y cada conexión al 9092 cuenta doble: la
# del cliente y la que se abre hacia el broker— quinientos sockets al 9092 alcanzaban para
# dejar sin servicio a la API y a la consola. Ese techo tan bajo era lo que obligaba a
# limitar el 9092 a 10 conexiones por IP, y eso cortaba a los equipos que comparten IP de
# salida (Render, ver ADR-025).
#
# El techo de descriptores tiene que cubrir las conexiones de un worker más los archivos
# que abre. El contenedor declara el mismo valor en `ulimits` del compose: nginx sólo puede
# subir su límite hasta el que le da el contenedor.
worker_processes     auto;
worker_rlimit_nofile 16384;

events {
    worker_connections 4096;
}

# ── Kafka: TLS por delante del listener SASL del broker ──────────────────────
# El cliente ve TLS y después negocia SASL por adentro, que es exactamente lo que
# significa security.protocol=SASL_SSL. El broker sigue hablando SASL_PLAINTEXT,
# pero ya no publica ese puerto hacia afuera.
#
# El cifrado termina acá y el último salto viaja en claro por el bridge de Docker,
# dentro de la misma VM. Si algún día el broker se muda a otra máquina, esto deja de
# alcanzar y hay que pasar a un keystore en el propio broker.
#
# El authorizer no se ve afectado: autoriza por principal SASL, no por IP de origen.
stream {
    # ── Cómo se protege este puerto (ADR-025) ──
    #
    # La conexión se acepta ANTES de SASL, así que hasta ahí nadie se identificó: lo único
    # que se sabe del cliente es su IP. Y una IP no es un cliente: detrás de la salida de
    # Render, de una facultad o de cualquier NAT hay muchos equipos. Contar conexiones
    # ABIERTAS por IP con un techo bajo los castiga a todos juntos, y obliga a reajustar el
    # número cada vez que se suma uno.
    #
    # Por eso el control principal no vive acá sino en el firewall del host (cadena
    # DOCKER-USER, deployment/oracle-single/firewall-kafka.sh): limita cuántas conexiones
    # NUEVAS por segundo abre cada IP. Un consumidor legítimo abre dos o tres y las mantiene
    # horas, así que cien equipos detrás de una IP no lo notan; un flood sí.
    #
    # Lo que queda acá es un tope de respaldo. Ningún tope de conexiones abiertas por IP es
    # bueno en las dos direcciones —alto, alcanza con pocas IPs para llenar nginx; bajo,
    # castiga a los que comparten salida—, así que el valor se elige mirando las dos:
    #
    #   - 64 conexiones son 128 lugares contando el salto al broker, 1/32 de UN worker. Para
    #     llenar nginx hacen falta unas 64 IPs distintas acumulando conexiones a la vez (con
    #     el tope viejo de 10 sobre un solo worker de 1024 bastaban unas 51).
    #   - Un equipo usa entre 2 y 5. Entran unos 20 equipos detrás de una misma IP, el
    #     doble de los que hay hoy en todo el curso.
    #
    # Hace falta porque el firewall frena la velocidad con que una IP abre conexiones, no
    # cuántas acumula: alguien sin credenciales puede completar el TLS y quedarse callado
    # hasta que el broker lo corta, a los 10 minutos.
    #
    # El límite vive en `stream` y no en `http`: son dos bloques distintos y `limit_conn`
    # del uno no alcanza al otro.
    limit_conn_zone $binary_remote_addr zone=kafka_conexiones:10m;

    # Una línea por conexión al cerrarse. Sin esto el 9092 no dejaba ningún rastro: ante un
    # problema como el de Render no había forma de saber qué IPs estaban conectadas ni
    # cuánto duraban. `$status` es 200 si la sesión terminó normal y 503 si la cortó el
    # tope de arriba.
    log_format kafka '$remote_addr [$time_local] status=$status '
                     'duracion=${session_time}s recibidos=$bytes_received enviados=$bytes_sent';
    access_log /dev/stdout kafka;

    # DNS interno de Docker. Sin esto, nginx resuelve `kafka-authorizer` UNA VEZ al
    # arrancar y se queda con esa IP: cuando el contenedor se recrea —un despliegue, un
    # reinicio tras un fallo— el proxy sigue mandando a una IP que ya no existe y los ocho
    # equipos pierden Kafka sin que nada lo avise.
    #
    # `ipv6=off` porque el DNS de Docker contesta AAAA que no llevan a ningún lado.
    resolver 127.0.0.11 valid=10s ipv6=off;

    server {
        # `so_keepalive`: si el cliente desaparece sin cerrar —un contenedor que se mata, una
        # red que se cae—, el kernel lo detecta en un minuto y medio (60 s sin tráfico, tres
        # sondas cada 10 s) en vez de dejar la conexión ocupando un lugar hasta que venza
        # `proxy_timeout`, diez minutos más tarde.
        listen 9092 ssl so_keepalive=60s:10s:3;

        ssl_certificate     /etc/letsencrypt/live/citypass/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/citypass/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;

        # Quien abre la conexión y no completa el handshake TLS ocupa un lugar sin haber
        # mostrado nada. El default es 60 s; un cliente real lo completa en milisegundos.
        ssl_handshake_timeout 10s;

        limit_conn kafka_conexiones 64;

        # Un cliente de Kafka abre una conexión por broker y la mantiene abierta esperando
        # mensajes, así que el timeout de inactividad tiene que ser largo o se cortarían
        # los consumidores legítimos. El de conexión, en cambio, es corto: el broker está
        # en el mismo host y si no atiende en cinco segundos no va a atender.
        proxy_connect_timeout 5s;
        proxy_timeout         10m;

        set $broker kafka-authorizer;
        proxy_pass $broker:9092;
    }
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;

    # Un evento con un payload grande no debería tumbar la conexión, pero tampoco
    # queremos aceptar cuerpos arbitrarios: el gateway todavía no tiene límite propio.
    client_max_body_size ${NGINX_MAX_BODY};

    # ── Límites por IP ────────────────────────────────────────────────────────
    #
    # El rate limit del gateway es por namespace, sacado del JWT, así que sólo alcanza a
    # las peticiones autenticadas que llegan hasta él. Las que van a /auth/ no lo tocan
    # —y emitir un token es una firma RSA, cara en CPU—, así que sin un límite acá
    # martillar ese endpoint es la forma más barata de saturar la máquina.
    #
    # `$binary_remote_addr` y no `$remote_addr`: ocupa 4 bytes por IPv4 en vez de hasta
    # 15, que con una zona de 10 MB es la diferencia entre 160 mil IPs y 40 mil.
    limit_req_zone  $binary_remote_addr zone=peticiones:10m rate=${NGINX_RATE_LIMIT};
    limit_conn_zone $binary_remote_addr zone=conexiones:10m;

    # 429 en vez del 503 que pone nginx por defecto: es lo que ya devuelve el gateway
    # cuando se pasa del límite, así que un cliente ve el mismo código venga de donde venga.
    limit_req_status  429;
    limit_conn_status 429;

    # DNS interno de Docker, para que los nombres de abajo se resuelvan en cada petición.
    # Ver el comentario de las variables en el server de 443.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # ── HTTP: sólo el desafío de ACME y redirección a HTTPS ──────────────────
    server {
        listen 80;
        server_name _;

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 443 ssl;

        # La ráfaga se acepta y se encola; lo que la supere se rechaza en el acto en
        # lugar de esperar, para que un ataque no consuma workers de nginx.
        limit_req  zone=peticiones burst=${NGINX_RATE_BURST} nodelay;
        limit_conn conexiones ${NGINX_CONN_LIMIT};
        http2 on;
        server_name _;

        ssl_certificate     /etc/letsencrypt/live/citypass/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/citypass/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;

        add_header Strict-Transport-Security "max-age=31536000" always;

        # Los destinos van en VARIABLES, y eso no es estilo: es lo que obliga a nginx a
        # resolver el nombre en cada petición en vez de una sola vez al arrancar.
        #
        # Con `proxy_pass http://event-gateway:8080` literal, nginx cachea la IP para
        # siempre. Cuando el contenedor se recrea —un despliegue, o el reinicio automático
        # tras un fallo— cambia de IP dentro del bridge y el proxy sigue mandando a la
        # anterior: todo responde 502 hasta que alguien recargue nginx.
        #
        # Con la variable, nginx consulta el DNS de Docker respetando el `valid=10s` del
        # resolver, así que una recreación se absorbe sola en diez segundos.
        set $gateway event-gateway;
        # URL completa, con esquema: el servicio de identidad es externo (Grupo 2).
        set $identidad ${AUTH_SERVICE_URL};
        set $anomalias anomaly-detector;
        set $ui frontend;
        set $dispatcher webhook-dispatcher;

        # Suscripciones y cola de fallidos: desde el ADR-020 son de webhook-dispatcher.
        #
        # Van ANTES de `/api/` sólo por legibilidad; nginx elige por prefijo más largo y no
        # por orden, así que estas dos ganan estén donde estén.
        #
        # El dispatcher es opcional (perfil `webhooks` de compose). Si no está desplegado,
        # el nombre no resuelve y estas rutas responden 502. Es lo que corresponde: no se
        # enmascara como 404, porque entonces un dispatcher caído —que es una falla real y
        # hay que verla— quedaría indistinguible de un despliegue que eligió no ofrecer
        # webhooks.
        location /api/v1/subscriptions {
            proxy_pass http://$dispatcher:8085;
            proxy_set_header Host              $host;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/v1/dead-letters {
            proxy_pass http://$dispatcher:8085;
            proxy_set_header Host              $host;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # `/internal/` NO se rutea a propósito: es el canal por el que el gateway consulta
        # suscripciones y no tiene autenticación propia. Su aislamiento es la red de Docker.

        # API del gateway.
        #
        # Sin URI después del puerto: así nginx pasa el request URI original tal cual,
        # que es lo que hacía la forma literal.
        location /api/ {
            proxy_pass http://$gateway:8080;
            proxy_set_header Host              $host;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /health {
            proxy_pass http://$gateway:8080/health;
        }

        # Servicio de identidad: login-federado, del Grupo 2. Se sigue ofreciendo bajo
        # `/auth/` para que la consola y los grupos que ya usaban
        # `https://<dominio>/auth/oauth/token` no tengan que cambiar nada.
        #
        # El `rewrite` reemplaza al `/` final que llevaría un proxy_pass literal, que es
        # lo que quita el prefijo `/auth/`. Con variables esa forma no sirve: nginx
        # mandaría TODAS las peticiones a `/` en vez de conservar el resto de la ruta.
        #
        # `Host` es el del destino y no el nuestro: es un servidor ajeno detrás de su
        # propio proxy, que rutea por nombre.
        #
        # `Origin` se borra por lo mismo que en el nginx de la consola: el navegador lo manda
        # en todo POST aunque sea del mismo origen, y login-federado lo compara contra SU
        # lista de CORS, donde este dominio no está. Sin esto responde 403 «Invalid CORS
        # request» y nadie puede ingresar a la consola. Para el navegador la petición es del
        # mismo origen, así que no hay ningún control de CORS que se esté salteando.
        location /auth/ {
            rewrite ^/auth/(.*)$ /$1 break;
            proxy_pass $identidad;
            proxy_set_header Host              $proxy_host;
            proxy_set_header Origin            "";
            proxy_set_header X-Forwarded-Proto $scheme;
            # Es un host público por HTTPS: SNI con su nombre (sin esto su TLS no sabe qué
            # certificado dar) y verificación del certificado contra las CA del sistema, porque
            # por acá viajan los `client_secret` de cada grupo.
            proxy_ssl_server_name on;
            proxy_ssl_verify on;
            proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
            proxy_ssl_verify_depth 3;
        }

        # Su `/health` pide token; el público es el de actuator. Se traduce acá para que
        # `/auth/health` siga significando «la identidad está arriba».
        location = /auth/health {
            proxy_pass $identidad/actuator/health;
            proxy_set_header Host   $proxy_host;
            proxy_set_header Origin "";
            # Mismo TLS que `/auth/`.
            proxy_ssl_server_name on;
            proxy_ssl_verify on;
            proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
            proxy_ssl_verify_depth 3;
        }

        # Detector de anomalías. No tiene CORS ni autenticación propia, así que sin esta
        # ruta ningún frontend podría alcanzarlo en producción — hasta ahora no hacía
        # falta porque nada lo consumía desde el navegador.
        location /anomaly/ {
            rewrite ^/anomaly/(.*)$ /$1 break;
            proxy_pass http://$anomalias:8084;
            proxy_set_header Host $host;
        }

        # La UI queda en la raíz: `frontend`, la consola Mantine.
        #
        # Sólo llega acá lo que no matcheó ningún prefijo de arriba: `/api/`, `/auth/` y
        # `/anomaly/` los resuelve este proxy antes, así que el nginx del `frontend` sólo
        # sirve el bundle y el `try_files` de la SPA.
        location / {
            proxy_pass http://$ui:8080;
            proxy_set_header Host $host;
        }

        # Schema Registry (8081) y kafka-ui (8090) NO se publican a propósito: no
        # tienen autenticación propia. Los grupos leen esquemas por la API del
        # gateway, que sí exige token salvo en el GET público.
    }
}
