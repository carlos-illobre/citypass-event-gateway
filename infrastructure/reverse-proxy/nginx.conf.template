# Reverse proxy de CityPass+ — sólo se usa en producción.
#
# Existe por dos motivos, y el segundo importa tanto como el primero:
#
#  1. Termina TLS. Sin esto el JWT viaja en claro, y todo el modelo de seguridad
#     —namespaces, ownership de suscripciones, el authorizer del broker— cuelga de
#     ese token: quien lo capture publica y consume como ese grupo.
#
#  2. Es el único servicio que escucha hacia afuera. El resto publica sus puertos
#     sobre 127.0.0.1 (PUBLISH_ADDR), así que desde internet no existen. Antes de
#     esto, el Schema Registry (8081) y kafka-ui (8090) quedaban expuestos sin
#     ninguna autenticación: cualquiera podía borrar subjects o administrar el
#     cluster.
#
# No tiene ninguna variable a propósito. La alternativa era expandirlo con envsubst
# al arrancar, pero envsubst también reemplazaría las variables propias de nginx
# ($host, $scheme, $proxy_add_x_forwarded_for) por cadenas vacías. En vez de eso el
# certificado se emite con un nombre fijo (certbot --cert-name citypass), así que la
# ruta no depende del dominio y el archivo se monta tal cual.

events {
    worker_connections 1024;
}

# ── Kafka: TLS por delante del listener SASL del broker ──────────────────────
# El cliente ve TLS y después negocia SASL por adentro, que es exactamente lo que
# significa security.protocol=SASL_SSL. El broker sigue hablando SASL_PLAINTEXT,
# pero ya no publica ese puerto hacia afuera.
#
# El cifrado termina acá y el último salto viaja en claro por el bridge de Docker,
# dentro de la misma VM. Si algún día el broker se muda a otra máquina, esto deja de
# alcanzar y hay que pasar a un keystore en el propio broker.
#
# El authorizer no se ve afectado: autoriza por principal SASL, no por IP de origen.
stream {
    # El techo de conexiones por IP vive acá y no en `http`: son dos bloques distintos y
    # `limit_conn` del uno no alcanza al otro. Sin esto, este puerto era el único camino
    # sin ningún límite hacia la VM.
    #
    # Importa que la conexión se acepta ANTES de SASL, así que este techo es lo único que
    # actúa contra alguien sin credenciales. Y como `worker_connections` se comparte con
    # el bloque `http`, agotarlo desde acá se llevaba puestos también la API y la UI.
    limit_conn_zone $binary_remote_addr zone=kafka_conexiones:10m;

    # DNS interno de Docker. Sin esto, nginx resuelve `kafka-authorizer` UNA VEZ al
    # arrancar y se queda con esa IP: cuando el contenedor se recrea —un despliegue, un
    # reinicio tras un fallo— el proxy sigue mandando a una IP que ya no existe y los ocho
    # equipos pierden Kafka sin que nada lo avise.
    #
    # `ipv6=off` porque el DNS de Docker contesta AAAA que no llevan a ningún lado.
    resolver 127.0.0.11 valid=10s ipv6=off;

    server {
        listen 9092 ssl;

        ssl_certificate     /etc/letsencrypt/live/citypass/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/citypass/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;

        limit_conn kafka_conexiones ${NGINX_KAFKA_CONN_LIMIT};

        # Un cliente de Kafka abre una conexión por broker y la mantiene abierta esperando
        # mensajes, así que el timeout de inactividad tiene que ser largo o se cortarían
        # los consumidores legítimos. El de conexión, en cambio, es corto: el broker está
        # en el mismo host y si no atiende en cinco segundos no va a atender.
        proxy_connect_timeout 5s;
        proxy_timeout         10m;

        set $broker kafka-authorizer;
        proxy_pass $broker:9092;
    }
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;

    # Un evento con un payload grande no debería tumbar la conexión, pero tampoco
    # queremos aceptar cuerpos arbitrarios: el gateway todavía no tiene límite propio.
    client_max_body_size ${NGINX_MAX_BODY};

    # ── Límites por IP ────────────────────────────────────────────────────────
    #
    # El rate limit del gateway es por namespace, sacado del JWT, así que sólo alcanza a
    # las peticiones autenticadas que llegan hasta él. Las que van a /auth/ no lo tocan
    # —y emitir un token es una firma RSA, cara en CPU—, así que sin un límite acá
    # martillar ese endpoint es la forma más barata de saturar la máquina.
    #
    # `$binary_remote_addr` y no `$remote_addr`: ocupa 4 bytes por IPv4 en vez de hasta
    # 15, que con una zona de 10 MB es la diferencia entre 160 mil IPs y 40 mil.
    limit_req_zone  $binary_remote_addr zone=peticiones:10m rate=${NGINX_RATE_LIMIT};
    limit_conn_zone $binary_remote_addr zone=conexiones:10m;

    # 429 en vez del 503 que pone nginx por defecto: es lo que ya devuelve el gateway
    # cuando se pasa del límite, así que un cliente ve el mismo código venga de donde venga.
    limit_req_status  429;
    limit_conn_status 429;

    # DNS interno de Docker, para que los nombres de abajo se resuelvan en cada petición.
    # Ver el comentario de las variables en el server de 443.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # ── HTTP: sólo el desafío de ACME y redirección a HTTPS ──────────────────
    server {
        listen 80;
        server_name _;

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 443 ssl;

        # La ráfaga se acepta y se encola; lo que la supere se rechaza en el acto en
        # lugar de esperar, para que un ataque no consuma workers de nginx.
        limit_req  zone=peticiones burst=${NGINX_RATE_BURST} nodelay;
        limit_conn conexiones ${NGINX_CONN_LIMIT};
        http2 on;
        server_name _;

        ssl_certificate     /etc/letsencrypt/live/citypass/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/citypass/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;

        add_header Strict-Transport-Security "max-age=31536000" always;

        # Los destinos van en VARIABLES, y eso no es estilo: es lo que obliga a nginx a
        # resolver el nombre en cada petición en vez de una sola vez al arrancar.
        #
        # Con `proxy_pass http://event-gateway:8080` literal, nginx cachea la IP para
        # siempre. Cuando el contenedor se recrea —un despliegue, o el reinicio automático
        # tras un fallo— cambia de IP dentro del bridge y el proxy sigue mandando a la
        # anterior: todo responde 502 hasta que alguien recargue nginx.
        #
        # Con la variable, nginx consulta el DNS de Docker respetando el `valid=10s` del
        # resolver, así que una recreación se absorbe sola en diez segundos.
        set $gateway event-gateway;
        set $identidad auth-simulator;
        set $ui event-gateway-ui;

        # API del gateway.
        #
        # Sin URI después del puerto: así nginx pasa el request URI original tal cual,
        # que es lo que hacía la forma literal.
        location /api/ {
            proxy_pass http://$gateway:8080;
            proxy_set_header Host              $host;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /health {
            proxy_pass http://$gateway:8080/health;
        }

        # Servicio de identidad. Cuando lo reemplace el del grupo 2, acá cambia el
        # destino y nada más.
        #
        # El `rewrite` reemplaza al `/` final que llevaba el proxy_pass literal, que era
        # lo que quitaba el prefijo `/auth/`. Con variables esa forma no sirve: nginx
        # mandaría TODAS las peticiones a `/` en vez de conservar el resto de la ruta.
        location /auth/ {
            rewrite ^/auth/(.*)$ /$1 break;
            proxy_pass http://$identidad:8083;
            proxy_set_header Host              $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # La UI queda en la raíz.
        location / {
            proxy_pass http://$ui:8080;
            proxy_set_header Host $host;
        }

        # Schema Registry (8081) y kafka-ui (8090) NO se publican a propósito: no
        # tienen autenticación propia. Los grupos leen esquemas por la API del
        # gateway, que sí exige token salvo en el GET público.
    }
}
