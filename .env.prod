# ===== CityPass+ EDA — valores para PRODUCCIÓN =====
#
#   cp .env.prod .env
#
# Hay un solo docker-compose.yml. Todo lo que cambia entre ambientes está acá y en su
# gemelo .env.dev.
#
# Reemplazar citypass.tudominio.com y el mail por los reales. El resto de los valores
# ya está listo.
#
#
# ─────────────────────────────────────────────────────────────────────────────
#  QUÉ FALTA PARA PODER DESPLEGAR
# ─────────────────────────────────────────────────────────────────────────────
#
#  Bloqueantes — sin esto no se puede desplegar:
#
#  1. UN DOMINIO APUNTANDO A LA VM.
#     Let's Encrypt no emite certificados para una IP pelada. Sin certificado de una
#     CA pública, cada grupo tendría que instalar un truststore propio en su cliente
#     de Kafka, y el que no lo logre va a terminar desactivando la verificación, que
#     es peor que no tener TLS porque parece seguro. Un subdominio gratuito alcanza:
#     crear un registro A hacia la IP pública de la VM.
#
#  2. EMITIR EL CERTIFICADO ANTES DEL PRIMER ARRANQUE.
#     nginx no levanta sin certificado y certbot necesita el puerto 80, así que hay un
#     orden obligatorio. El comando está en docs/DEPLOYMENT.md, paso 6.
#
#  3. REEMPLAZAR EL SERVICIO DE IDENTIDAD.
#     auth-simulator es un mock: credenciales fijas en el código y clave de firma que
#     se regenera en cada arranque, o sea que cada reinicio invalida todos los tokens
#     emitidos. El event-gateway ya está preparado para un emisor real —valida firma,
#     audiencia y expiración contra el JWKS—, pero mientras el emisor sea el mock, la
#     plataforma entera confía en él. Lo reemplaza el grupo 2.
#
#
#  No bloqueantes, pero conviene saberlos antes de exponer esto:
#
#  4. UNA SOLA INSTANCIA. Las suscripciones y los schemas viven en archivos dentro de
#     un volumen local. Dos gateways divergen, y perder el volumen borra las
#     suscripciones.
#
#  5. LA ENTREGA DE WEBHOOKS NO SOBREVIVE UN REINICIO. Corre en memoria sobre un
#     virtual thread; si el gateway se reinicia durante los reintentos, el evento se
#     pierde sin dejar ni una entrada en la DLQ.
#
#  6. EL DISCO ES UN TECHO DURO, NO UN AVISO. El boot volume de esta VM coincide con el
#     cupo gratuito de almacenamiento, así que si se llena no se puede agrandar sin
#     pagar. Lo acotan tres cosas, todas más abajo en este archivo: la rotación de los
#     logs de los contenedores, la retención de Kafka por tamaño, y el rate limit por
#     namespace multiplicado por el tamaño máximo del evento. Revisá esos tres números
#     antes de exponer esto, y volvé a revisarlos si cambia el tamaño del disco.
#
#  7. LAS MÉTRICAS NO TIENEN ALERTAS. Prometheus guarda la serie y Grafana la muestra,
#     pero nadie avisa cuando algo se rompe: hay que ir a mirar el dashboard.
#
#  8. EL CIFRADO TERMINA EN EL PROXY. El último salto hasta el broker viaja en claro
#     por el bridge de Docker, dentro de la misma VM. Alcanza mientras todo corra en
#     una sola máquina; si el broker se muda, hay que pasar a un keystore en el broker.
#
# ─────────────────────────────────────────────────────────────────────────────


# ── Exposición de puertos ─────────────────────────────────────────────────────

# Interfaz del host donde se publican los puertos de los contenedores.
# En 127.0.0.1 Docker no programa la regla de entrada, así que desde internet esos
# puertos NO EXISTEN. El único servicio que escucha hacia afuera es el reverse-proxy.
# Siguen alcanzables desde la propia VM, que es lo que permite depurar por un túnel
# SSH sin abrir nada.
PUBLISH_ADDR=127.0.0.1

# Puerto del host para el listener externo de Kafka. NO puede ser 9092: ese puerto lo
# ocupa el reverse-proxy, que termina TLS y reenvía al broker. Con los dos en 9092 el
# proxy no puede reservarlo, Docker deja el contenedor sin red, y nginx entra en un
# bucle de reinicios quejándose de que no resuelve los upstreams — un síntoma que no
# se parece en nada a la causa.
KAFKA_HOST_PORT=19092

# Perfiles de Compose activos. `prod` es lo que hace existir a reverse-proxy y certbot.
# El valor tiene que ser exactamente ese: Compose ignora en silencio un perfil que no
# existe, así que si el proxy no aparece, esto es lo primero que hay que mirar.
COMPOSE_PROFILES=prod


# ── Identidad de red ──────────────────────────────────────────────────────────

# Hostname del broker que se anuncia a los clientes. Un cliente Kafka pide metadata y
# después se reconecta a la dirección que el broker le devuelve, así que tiene que ser
# el dominio público — y el MISMO del certificado, o la verificación TLS falla.
KAFKA_ADVERTISED_HOST=citypass.tudominio.com

# Dominio del certificado. No lo lee el compose: lo usa el comando de emisión inicial
# de certbot (docs/DEPLOYMENT.md, paso 6). La config de nginx no lo referencia porque
# el certificado se emite con el nombre fijo `citypass`.
PUBLIC_DOMAIN=citypass.tudominio.com

# Mail donde Let's Encrypt avisa si un certificado está por vencer sin renovarse.
CERTBOT_EMAIL=vos@tudominio.com


# ── Comportamiento del event-gateway ──────────────────────────────────────────

# Único interruptor de ambiente del gateway, y va VACÍO en producción.
#
# Los valores de producción están escritos literales en application.yml, así que son
# los que rigen mientras no se active ningún perfil: no acepta webhooks hacia la red
# interna (en true sería un SSRF hacia el endpoint de metadata del cloud), no publica
# Swagger, y loguea en INFO en vez de volcar los payloads de todos los grupos al log.
#
# Sólo el valor exacto `development` los afloja. Vacío, mal escrito o cualquier otro
# nombre deja producción, que es la dirección segura para equivocarse.
SPRING_PROFILES_ACTIVE=


# ── kafka-ui ──────────────────────────────────────────────────────────────────

# Login propio de kafka-ui, la única credencial del sistema fuera del servicio de
# identidad. kafka-ui administra el cluster entero, y el auth-simulator sólo hace
# client_credentials, así que un navegador no tiene cómo autenticarse contra él.
#
# ATENCIÓN: este archivo SE VERSIONA. La contraseña real no va acá — se escribe
# solamente en el .env de la VM, que está en .gitignore. Dejar el placeholder.
#
# En producción no se llega a kafka-ui por el dominio: no está publicado, y el acceso
# normal es por túnel SSH (ver docs/DEPLOYMENT.md). Este login es la red que queda si
# PUBLISH_ADDR sale mal y el 8090 termina expuesto, porque en ese caso se llega sin
# pasar por el reverse-proxy y una autenticación puesta ahí no serviría de nada.
# Interfaz donde se publica kafka-ui, independiente de PUBLISH_ADDR. En 127.0.0.1 el
# contenedor corre pero desde internet no existe: se llega por túnel SSH. Ponerlo en
# 0.0.0.0 expone a la red una consola con permisos de administración total del cluster,
# y encima sin pasar por el reverse-proxy.
KAFKA_UI_PUBLISH_ADDR=127.0.0.1

KAFKA_UI_USER=CAMBIAR
KAFKA_UI_PASSWORD=CAMBIAR


# ── Grafana ───────────────────────────────────────────────────────────────────

# Credenciales del administrador de Grafana. Como las de kafka-ui, no salen del servicio
# de identidad: Grafana es una herramienta de operación y el emisor sólo hace
# client_credentials, así que un navegador no puede autenticarse contra él.
#
# ATENCIÓN: este archivo SE VERSIONA. La contraseña real va sólo en el .env de la VM.
GRAFANA_USER=CAMBIAR
GRAFANA_PASSWORD=CAMBIAR


# ── CORS y URLs del frontend ──────────────────────────────────────────────────

# Orígenes que pueden llamar a cada servicio desde el navegador. Un solo origen: el
# dominio real, con https. Nunca un asterisco — con CORS abierto, cualquier página que
# visite un usuario logueado puede hacer llamadas al gateway con su sesión.
AUTH_CORS_ORIGIN=https://citypass.tudominio.com
GATEWAY_CORS_ORIGIN=https://citypass.tudominio.com

# URLs que Vite embebe en el build de la UI. Se resuelven en el navegador del usuario,
# así que van al dominio público a través del proxy, no a los nombres de los
# contenedores. Son argumentos de BUILD: cambiarlas exige `docker compose build
# event-gateway-ui`, no alcanza con reiniciar.
LOGIN_API_URL=https://citypass.tudominio.com/auth
GATEWAY_API_URL=https://citypass.tudominio.com/api/v1

# ─────────────────────────────────────────────────────────────────────────────
# Imágenes
# ─────────────────────────────────────────────────────────────────────────────

# Registro desde donde la instancia descarga las imágenes ya compiladas.
#
# En producción NUNCA se construye: compilar en la instancia deja la aplicación degradada
# durante el build, llena el disco de caché, y si el build falla te quedaste sin ambiente.
IMAGE_PREFIX=ghcr.io/carlos-illobre/citypass-event-gateway

# SHA del commit desplegado. Lo reescribe `deploy.sh` en cada despliegue.
#
# Para volver a una versión anterior: poner acá su SHA y `docker compose up -d`.
TAG=latest

# ─────────────────────────────────────────────────────────────────────────────
# Techos de recursos
# ─────────────────────────────────────────────────────────────────────────────
#
# Dependen del ambiente: la memoria de la máquina y el tamaño del disco no son los
# mismos en una laptop que en la VM que la hospede. Por eso viven acá y no en el
# compose — que no sabe dónde va a correr.
#
# Los tres bloques responden a tres formas de tumbar el servicio:
# el disco lleno, la memoria agotada y la CPU saturada.

# ── Memoria máxima por contenedor ────────────────────────────────────────────
#
# Sin techo, cualquiera de los nueve puede consumir toda la RAM y disparar al OOM
# killer del kernel, que elige al proceso más grande —normalmente el broker— y se lleva
# puesto todo, no sólo al que se desbocó.
#
# Los JVM leen el límite del contenedor y ajustan su heap solo (por defecto al 25 %),
# así que no hace falta configurarles -Xmx aparte.

# El broker: es el que más pesa y el que más duele perder.
MEM_LIMIT_KAFKA=2g
MEM_LIMIT_SCHEMA_REGISTRY=1g
# Medido en reposo: ~360 MB.
MEM_LIMIT_EVENT_GATEWAY=1g
MEM_LIMIT_KAFKA_UI=768m
MEM_LIMIT_PROMETHEUS=512m
MEM_LIMIT_GRAFANA=384m
# Carga scikit-learn.
MEM_LIMIT_ANOMALY_DETECTOR=512m
MEM_LIMIT_AUTH_SIMULATOR=256m
# Sólo sirve estáticos.
MEM_LIMIT_EVENT_GATEWAY_UI=128m

# ── Disco ────────────────────────────────────────────────────────────────────

# Tamaño máximo del log de cada contenedor, y cuántos archivos rotados se guardan.
#
# El driver json-file de Docker NO tiene límite por defecto: cada línea que escribe un
# servicio se guarda para siempre. Es la forma más silenciosa de llenar un disco, porque
# no pasa por ningún rate limit ni deja rastro en la aplicación.
#
# 10m × 3 archivos × 9 contenedores = 270 MB como techo.
# 512 KB por archivo y dos archivos: un megabyte por contenedor, que es lo que se lee
# antes de aburrirse. Se parte en dos en vez de usar uno solo de 1 MB porque con un solo
# archivo, al rotar se pierde el log entero justo cuando algo estaba pasando.
LOG_MAX_SIZE=512k
LOG_MAX_FILES=2

# Retención de Kafka por TAMAÑO, en bytes POR PARTICIÓN.
#
# La retención por tiempo que trae el broker por defecto (7 días) no acota el disco: si
# entran más datos de los que caben, se llena igual. Ésta sí es un techo.
#
# OJO CON LA UNIDAD: Kafka no tiene un límite global por broker. Esto es por partición, y
# hay una partición por event type, así que el total es este número × la cantidad de
# event types. Con 5 MB, diez event types ocupan 50 MB y cien ocupan 500 MB.
KAFKA_RETENTION_BYTES=5242880

# Tamaño de cada segmento del log, en bytes.
#
# No es un detalle: Kafka borra SEGMENTOS enteros, nunca eventos sueltos. Con el default
# de 1 GB, el segmento activo crece hasta 1 GB antes de rotar, así que una retención de
# 5 MB no podría borrar nada — el techo de arriba sería decorativo.
#
# Tiene que ser bastante menor que la retención para que haya varios segmentos y siempre
# se pueda borrar el más viejo.
KAFKA_SEGMENT_BYTES=1048576


# ── Límites de la API ────────────────────────────────────────────────────────

# Peticiones por minuto y por namespace, y tamaño máximo del cuerpo de un evento.
#
# Estos dos números multiplicados son la velocidad a la que un equipo puede llenar el
# disco: 60 × 262144 = 15 MB/min, unas 22 horas para 200 GB. Con los valores de antes
# —600 por minuto— eran menos de tres.
RATE_LIMIT_PER_MINUTE=60
MAX_PAYLOAD_BYTES=262144

# Máximo de event types por namespace.
#
# Es el único techo posible a la cantidad de tópicos: el gateway es el único que puede
# crearlos, porque el authorizer se lo niega a todo cliente externo y la autocreación del
# broker está apagada. Y la cantidad de tópicos es lo que multiplica a KAFKA_RETENTION_BYTES.
#
# Con 25 y ocho namespaces son 200 event types como mucho: unos 200 x 5 MB = 1 GB de
# disco, y 250 particiones contando las internas de Kafka. El disco aguanta de sobra; el
# que se degrada antes es el broker, que en esta VM tiene dos núcleos.
MAX_EVENT_TYPES_PER_NAMESPACE=25



# ── Límites del reverse-proxy ────────────────────────────────────────────────
#
# El rate limit del gateway es POR NAMESPACE, sacado del JWT, así que sólo alcanza a
# las peticiones autenticadas que llegan hasta él. Las que van a /auth/ no lo tocan — y
# emitir un token es una firma RSA, cara en CPU. Sin un límite acá, martillar ese
# endpoint es la forma más barata de saturar la máquina.

# Peticiones por segundo y por IP, y cuántas se aceptan de más en una ráfaga.
NGINX_RATE_LIMIT=5r/s
NGINX_RATE_BURST=20

# Conexiones simultáneas por IP.
NGINX_CONN_LIMIT=20

# Tamaño máximo del cuerpo. Corta antes de que el cuerpo llegue a la aplicación.
NGINX_MAX_BODY=1m
