# Reverse proxy de CityPass+ — sólo se usa en producción.
#
# Existe por dos motivos, y el segundo importa tanto como el primero:
#
#  1. Termina TLS. Sin esto el JWT viaja en claro, y todo el modelo de seguridad
#     —namespaces, ownership de suscripciones, el authorizer del broker— cuelga de
#     ese token: quien lo capture publica y consume como ese grupo.
#
#  2. Es el único servicio que escucha hacia afuera. El resto publica sus puertos
#     sobre 127.0.0.1 (PUBLISH_ADDR), así que desde internet no existen. Antes de
#     esto, el Schema Registry (8081) y kafka-ui (8090) quedaban expuestos sin
#     ninguna autenticación: cualquiera podía borrar subjects o administrar el
#     cluster.
#
# No tiene ninguna variable a propósito. La alternativa era expandirlo con envsubst
# al arrancar, pero envsubst también reemplazaría las variables propias de nginx
# ($host, $scheme, $proxy_add_x_forwarded_for) por cadenas vacías. En vez de eso el
# certificado se emite con un nombre fijo (certbot --cert-name citypass), así que la
# ruta no depende del dominio y el archivo se monta tal cual.

events {
    worker_connections 1024;
}

# ── Kafka: TLS por delante del listener SASL del broker ──────────────────────
# El cliente ve TLS y después negocia SASL por adentro, que es exactamente lo que
# significa security.protocol=SASL_SSL. El broker sigue hablando SASL_PLAINTEXT,
# pero ya no publica ese puerto hacia afuera.
#
# El cifrado termina acá y el último salto viaja en claro por el bridge de Docker,
# dentro de la misma VM. Si algún día el broker se muda a otra máquina, esto deja de
# alcanzar y hay que pasar a un keystore en el propio broker.
#
# El authorizer no se ve afectado: autoriza por principal SASL, no por IP de origen.
stream {
    server {
        listen 9092 ssl;

        ssl_certificate     /etc/letsencrypt/live/citypass/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/citypass/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;

        proxy_pass kafka-authorizer:9092;
    }
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;

    # Un evento con un payload grande no debería tumbar la conexión, pero tampoco
    # queremos aceptar cuerpos arbitrarios: el gateway todavía no tiene límite propio.
    client_max_body_size ${NGINX_MAX_BODY};

    # ── Límites por IP ────────────────────────────────────────────────────────
    #
    # El rate limit del gateway es por namespace, sacado del JWT, así que sólo alcanza a
    # las peticiones autenticadas que llegan hasta él. Las que van a /auth/ no lo tocan
    # —y emitir un token es una firma RSA, cara en CPU—, así que sin un límite acá
    # martillar ese endpoint es la forma más barata de saturar la máquina.
    #
    # `$binary_remote_addr` y no `$remote_addr`: ocupa 4 bytes por IPv4 en vez de hasta
    # 15, que con una zona de 10 MB es la diferencia entre 160 mil IPs y 40 mil.
    limit_req_zone  $binary_remote_addr zone=peticiones:10m rate=${NGINX_RATE_LIMIT};
    limit_conn_zone $binary_remote_addr zone=conexiones:10m;

    # 429 en vez del 503 que pone nginx por defecto: es lo que ya devuelve el gateway
    # cuando se pasa del límite, así que un cliente ve el mismo código venga de donde venga.
    limit_req_status  429;
    limit_conn_status 429;

    # ── HTTP: sólo el desafío de ACME y redirección a HTTPS ──────────────────
    server {
        listen 80;
        server_name _;

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 443 ssl;

        # La ráfaga se acepta y se encola; lo que la supere se rechaza en el acto en
        # lugar de esperar, para que un ataque no consuma workers de nginx.
        limit_req  zone=peticiones burst=${NGINX_RATE_BURST} nodelay;
        limit_conn conexiones ${NGINX_CONN_LIMIT};
        http2 on;
        server_name _;

        ssl_certificate     /etc/letsencrypt/live/citypass/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/citypass/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;

        add_header Strict-Transport-Security "max-age=31536000" always;

        # API del gateway.
        location /api/ {
            proxy_pass http://event-gateway:8080;
            proxy_set_header Host              $host;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /health {
            proxy_pass http://event-gateway:8080/health;
        }

        # Servicio de identidad. Cuando lo reemplace el del grupo 2, acá cambia el
        # destino y nada más.
        location /auth/ {
            proxy_pass http://auth-simulator:8083/;
            proxy_set_header Host              $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # La UI queda en la raíz.
        location / {
            proxy_pass http://event-gateway-ui:80;
            proxy_set_header Host $host;
        }

        # Schema Registry (8081) y kafka-ui (8090) NO se publican a propósito: no
        # tienen autenticación propia. Los grupos leen esquemas por la API del
        # gateway, que sí exige token salvo en el GET público.
    }
}
