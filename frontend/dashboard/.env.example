# Copiá este archivo a `.env` antes de arrancar:  cp .env.example .env
#
# Las URLs son relativas a propósito: el proxy de `vite.config.ts` las reenvía a los servicios,
# así que todas las llamadas salen del mismo origen y no hay CORS de por medio. Los mismos
# valores sirven detrás del nginx de producción, que usa estos mismos prefijos.
VITE_AUTH_API_URL=/auth
VITE_GATEWAY_API_URL=/api/v1
VITE_GATEWAY_HEALTH_URL=/health
VITE_ANOMALY_API_URL=/anomaly

# Destinos del proxy. Los lee Node al levantar Vite, no el navegador: sin el prefijo `VITE_`,
# así que no terminan en el bundle.
PROXY_GATEWAY_TARGET=http://localhost:8080
PROXY_AUTH_TARGET=http://localhost:8083
PROXY_ANOMALY_TARGET=http://localhost:8084

# Usadas sólo por `scripts/seed-demo.mjs`, que corre en Node y le pega directo a los servicios.
SEED_CLIENT_ID=grupo8
SEED_CLIENT_SECRET=grupo8
